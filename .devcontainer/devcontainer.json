{
	"name": "Ubuntu",
	"image": "mcr.microsoft.com/devcontainers/base:jammy",
	"features": {
		"ghcr.io/rocker-org/devcontainer-features/r-dependent-packages:0": {
			"when": "postCreate",
			"pakVersion": "auto",
			"manifestRoot": ".",
			"additionalRepositories": "",
			"dependencyTypes": "all,Config/Needs/website"
		},
		"ghcr.io/rocker-org/devcontainer-features/r-history:0": {},
		"ghcr.io/rocker-org/devcontainer-features/r-rig:1": {
			"installDevTools": true,
			"installRMarkdown": true,
			"installRadian": true,
			"installVscDebugger": true,
			"version": "release",
			"pakVersion": "auto",
			"vscodeRSupport": "full",
			"pandocVersion": "auto"
		},
		"ghcr.io/stuartleeks/dev-container-features/shell-history:0": {},
		"ghcr.io/jpawlowski/devcontainer-features/cascadia-code:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/rocker-org/devcontainer-features/rstudio-server:0": {}
	},

	"onCreateCommand": "cp .devcontainer/rstudio-prefs.json /home/vscode/.config/rstudio/",
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [8787],
	"postAttachCommand": {
		"rstudio-start": "rserver"
	},
	"portsAttributes": {
		"8787": {
			"label": "RStudio IDE",
			"onAutoForward": "openBrowser"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"mhutchie.git-graph",
				"donjayamanne.githistory",
				"waderyan.gitblame",
				"GitHub.vscode-pull-request-github",
				"REditorSupport.r",
				"bierner.markdown-preview-github-styles",
				"ionutvmi.path-autocomplete",
				"RDebugger.r-debugger"
			]
		}
	}
}
